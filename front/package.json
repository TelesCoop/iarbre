{
  "name": "iarbre-front",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/sync-tarteaucitron.mjs && vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview --port 4173",
    "test": "vitest tests",
    "test:unit": "vitest",
    "test:cypress": "CYPRESS_COVERAGE=true NODE_ENV=test start-server-and-test 'vite dev --port 4173' http://localhost:4173 'cypress run'",
    "test:prod": "cypress run --config-file cypress.prod.config.ts",
    "test:cypress:manually": "NODE_ENV=test start-server-and-test 'vite dev --port 4173' http://localhost:4173 'cypress open'",
    "build-only": "node scripts/sync-tarteaucitron.mjs && vite build",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@certible/use-matomo": "^1.2.1",
    "@photo-sphere-viewer/core": "^5.15.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vue/test-utils": "^2.5.1",
    "@vueuse/core": "^14.0.0",
    "d3": "^7.9.0",
    "driver.js": "^1.8.0",
    "jsdom": "^26.1.0",
    "maplibre-gl": "^6.11.2",
    "maplibre-gl-panoramax": "^0.4.0",
    "pinia": "^3.0.0",
    "polished": "^4.3.1",
    "strip-ansi": "^7.2.0",
    "tarteaucitronjs": "^1.35.1",
    "terra-draw": "^1.35.0",
    "terra-draw-maplibre-gl-adapter": "^1.4.1",
    "vue": "^3.5.43",
    "vue-router": "^4.3.3"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.29.9",
    "@cypress/code-coverage": "^4.0.3",
    "@lavamoat/allow-scripts": "^3.4.1",
    "@pinia/testing": "^1.0.0",
    "@rushstack/eslint-patch": "^1.16.1",
    "@tsconfig/node20": "^20.1.10",
    "@types/d3": "^7.4.3",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^20.14.5",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^13.0.0",
    "@vue/tsconfig": "^0.9.1",
    "babel-plugin-istanbul": "^8.0.0",
    "cypress": "^16.1.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-cypress": "^3.3.0",
    "eslint-plugin-eslint-plugin": "^6.3.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^9.23.0",
    "npm-run-all2": "^6.2.0",
    "prettier": "^3.9.9",
    "start-server-and-test": "^2.0.4",
    "tailwindcss": "^4.0.17",
    "typescript": "5.9.3",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.2",
    "vite-plugin-istanbul": "^9.0.1",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^4.1.9",
    "vue-tsc": "^3.3.12"
  },
  "lavamoat": {
    "allowScripts": {
      "cypress": true,
      "vite>esbuild": true
    }
  }
}
