[security]
secret_key={{ vault_django_secret_key }}
allowed_hosts={{ ", ".join(public_hostnames) }}, localhost

[mail]
api_key={{ vault_mailgun_api_key }}

[backup]
backup_access={{ vault_backup_access }}
backup_secret={{ vault_backup_secret }}
backup_bucket=telescoop-iarbre
backup_compress=true
backup_recovery_n_workers=4
backup_host=s3.fr-par.scw.cloud

[external_file_storage]
access={{ vault_backup_access }}
secret={{ vault_backup_secret }}
bucket=telescoop-iarbre
host=s3.fr-par.scw.cloud
region=fr-par

[bugs]
rollbar_access_token={{ vault_rollbar_access_token }}

[staticfiles]
static_root={{ backend_static_path }}

[database]
engine=postgresql
user={{ database_user }}
name={{ database_name }}
password = {{ database_password|default('') }}

[environment]
environment = {{ environment_name }}

[github_oauth]
client_id= {{ vault_github_oauth_client_id }}
client_secret= {{ vault_github_oauth_client_secret }}

[media]
media_root={{backend_media_path}}

[throttling]
# The server's own IPs: the PDF export's headless browser calls the API from here.
# throttle_exempt_extra_ips: IPs not on an interface (e.g. a NAT public IP).
exempt_ips={{ (ansible_all_ipv4_addresses + ansible_all_ipv6_addresses + ['127.0.0.1', '::1'] + (throttle_exempt_extra_ips | default([]))) | unique | join(', ') }}
